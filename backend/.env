# Django Settings
DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
# The Django DB stays on local SQLite (reliable, no network needed).
# USE_SQLITE=True -> uses backend/db.sqlite3
# Set USE_SQLITE=False AND fill DB_* below to use your Supabase Postgres instead.
USE_SQLITE=True

# --- Optional: Supabase Postgres (only used when USE_SQLITE=False) ---
DB_ENGINE=django.db.backends.postgresql
DB_NAME=postgres
# Use the Session Pooler connection string from Supabase (Settings -> Database):
#   host: aws-0-<region>.pooler.supabase.com   user: postgres.<project-ref>   port: 5432
DB_USER=postgres.PASTE_PROJECT_REF
DB_PASSWORD=PASTE_DB_PASSWORD_HERE
DB_HOST=aws-0-REGION.pooler.supabase.com
DB_PORT=5432

# Supabase Configuration (REQUIRED for auth)
# Dashboard -> Project Settings -> API
